{
  "name": "pits-club",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:preview": "vite build --mode preview",
    "seed": "python3 -I scripts/make_seed.py",
    "test": "vitest run",
    "build:api": "esbuild server/bot.ts --bundle --platform=node --format=esm --target=node18 --outfile=api/bot.js --banner:js='// Fichier généré par « npm run build:api » à partir de server/bot.ts : ne pas modifier à la main.'"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.2",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vite-plugin-singlefile": "2.0.2",
    "vitest": "2.1.4"
  }
}
